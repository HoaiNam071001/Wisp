{
  "name": "flash-browser",
  "productName": "Flash Browser",
  "version": "1.0.0",
  "description": "App đơn giản mở trang web có Flash (chạy bằng Ruffle)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.7.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "local.flashbrowser",
    "productName": "Flash Browser",
    "mac": {
      "category": "public.app-category.games",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "identity": null
    },
    "fileAssociations": [
      { "ext": "swf", "name": "Flash Movie", "role": "Viewer" }
    ],
    "asarUnpack": ["node_modules/@ruffle-rs/ruffle/**"]
  }
}
