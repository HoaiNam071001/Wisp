{
  "name": "wisp",
  "productName": "Wisp",
  "version": "2.2.0",
  "description": "Wisp — trình duyệt mở webgame Flash bằng Flash Player thật (Pepper Flash) trong Electron 11; dự phòng bằng Ruffle",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --x64",
    "dist:personal": "electron-builder --mac dmg --x64 --config electron-builder.personal.js"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "lzma": "2.3.2"
  },
  "devDependencies": {
    "electron": "11.5.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.wisp",
    "productName": "Wisp",
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "files": [
      "main.js",
      "toolbar.html",
      "toolbar-preload.js",
      "inspect.html",
      "inspect-preload.js",
      "history.html",
      "menu.html",
      "menu-preload.js",
      "updater.js",
      "page-preload.js",
      "player.html",
      "package.json",
      "node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "swf",
        "name": "Flash Movie",
        "role": "Viewer"
      }
    ],
    "asarUnpack": [
      "node_modules/@ruffle-rs/ruffle/**"
    ]
  }
}
