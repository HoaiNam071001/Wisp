{
  "name": "wisp",
  "productName": "Wisp",
  "version": "3.0.0",
  "description": "Wisp — trình duyệt (Electron mới) mở webgame Flash bằng Flash Player thật (Pepper Flash, engine Electron 11 đi kèm; macOS, Windows)",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/",
    "check": "node scripts/check-syntax.js",
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "release": "node scripts/release.js",
    "dist": "electron-builder --mac dmg --x64",
    "dist:personal": "electron-builder --mac dmg --x64 --config electron-builder.personal.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:personal": "electron-builder --win nsis --x64 --config electron-builder.personal.js"
  },
  "dependencies": {
    "lzma": "2.3.2",
    "ws": "7.5.10"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "^24.13.3",
    "electron-flash": "npm:electron@11.5.0"
  },
  "build": {
    "appId": "local.wisp",
    "productName": "Wisp",
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "node_modules/electron-flash/dist",
          "to": "game",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "node_modules/electron-flash/dist",
          "to": "game",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wisp",
      "artifactName": "${productName}-${version}-win-setup.${ext}"
    },
    "files": [
      "main.js",
      "config.js",
      "user-data.js",
      "urls.js",
      "app-urls.js",
      "util.js",
      "ua.js",
      "nav-policy.js",
      "bookmarks.js",
      "bookmarks-store.js",
      "bookmarks-import.js",
      "bookmarks-bar.js",
      "popover.js",
      "site-info.js",
      "site-info-window.js",
      "site-info-preload.js",
      "site-info.html",
      "favicon-cache.js",
      "bookmarks-list-window.js",
      "bookmarks-list-preload.js",
      "bookmarks-list.html",
      "bookmark-rename-window.js",
      "bookmark-rename-preload.js",
      "bookmark-rename.html",
      "chrome-bookmarks.js",
      "bookmarks.html",
      "site-zoom.js",
      "find-window.js",
      "find-preload.js",
      "find.html",
      "popup-policy.js",
      "permission-policy.js",
      "permissions.js",
      "downloads.js",
      "download-name.js",
      "tabs.js",
      "history.js",
      "perf.js",
      "progress-tasks.js",
      "ping.js",
      "browsing-data.js",
      "page-actions.js",
      "page-menu.js",
      "app-menu.js",
      "menu-popup.js",
      "toolbar-ipc.js",
      "flash/**/*",
      "flash-engine/**/*",
      "inspect/**/*",
      "ghosthand/**/*",
      "toolbar.html",
      "toolbar-preload.js",
      "inspect.html",
      "inspect-preload.js",
      "history.html",
      "keyremap.js",
      "google-auth.js",
      "google-pkce.js",
      "token-store.js",
      "sync.js",
      "account-window.js",
      "account-preload.js",
      "account.html",
      "sync-run.js",
      "sync-drive.js",
      "sync-merge.js",
      "sync-crypt.js",
      "sync-cookies.js",
      "cookie-sync.js",
      "keyremap-main.js",
      "keys.html",
      "keys-preload.js",
      "flash-settings.html",
      "flash-launcher.html",
      "flash-settings-preload.js",
      "menu.html",
      "menu-preload.js",
      "updater.js",
      "page-preload.js",
      "player.html",
      "flash-win.js",
      "platform-ui.js",
      "package.json",
      "node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "swf",
        "name": "Flash Movie",
        "role": "Viewer"
      }
    ]
  }
}
