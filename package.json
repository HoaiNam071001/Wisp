{
  "name": "wisp",
  "productName": "Wisp",
  "version": "2.4.1",
  "description": "Wisp — trình duyệt mở webgame Flash bằng Flash Player thật (Pepper Flash) trong Electron 11 (macOS, Windows); dự phòng bằng Ruffle",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/",
    "check": "node scripts/check-syntax.js",
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "dist": "electron-builder --mac dmg --x64",
    "dist:personal": "electron-builder --mac dmg --x64 --config electron-builder.personal.js",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:win:personal": "electron-builder --win nsis --x64 --config electron-builder.personal.js"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.7.1",
    "lzma": "2.3.2",
    "ws": "7.5.10"
  },
  "devDependencies": {
    "electron": "11.5.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.wisp",
    "productName": "Wisp",
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wisp",
      "artifactName": "${productName}-${version}-win-setup.${ext}"
    },
    "files": [
      "main.js",
      "config.js",
      "user-data.js",
      "urls.js",
      "app-urls.js",
      "util.js",
      "tabs.js",
      "history.js",
      "perf.js",
      "progress-tasks.js",
      "ping.js",
      "page-actions.js",
      "app-menu.js",
      "menu-popup.js",
      "toolbar-ipc.js",
      "flash/**/*",
      "inspect/**/*",
      "ghosthand/**/*",
      "toolbar.html",
      "toolbar-preload.js",
      "inspect.html",
      "inspect-preload.js",
      "history.html",
      "keyremap.js",
      "keyremap-main.js",
      "keys.html",
      "keys-preload.js",
      "menu.html",
      "menu-preload.js",
      "updater.js",
      "page-preload.js",
      "player.html",
      "flash-win.js",
      "platform-ui.js",
      "package.json",
      "node_modules/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "swf",
        "name": "Flash Movie",
        "role": "Viewer"
      }
    ],
    "asarUnpack": [
      "node_modules/@ruffle-rs/ruffle/**"
    ]
  }
}
